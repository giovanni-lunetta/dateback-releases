build/memory-organizer/
build/memory-organizer-x64/

# PyInstaller worker binaries are regenerated by `npm run build:binary:*` and
# copied into assets/bin before packaging — don't track the outputs in git.
# (Vendored ffmpeg binaries ARE tracked: nothing in-repo regenerates them.)
assets/bin/mac-arm64/memory-organizer
assets/bin/mac-x64/memory-organizer
assets/bin/win-x64/memory-organizer.exe

