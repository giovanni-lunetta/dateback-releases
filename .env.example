# DateBack Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# =============================================================================
# GitHub Token for Auto-Updates
# =============================================================================
# Used by: electron-updater to check for new releases
# Get from: https://github.com/settings/tokens
# Required scopes: None for the public dateback-releases repository
# Optional: repo:read only for internal/private release checks
#
# Example format: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=your_github_token_here

# =============================================================================
# Apple App-Specific Password
# =============================================================================
# Used by: electron-builder for code signing and notarization
# Get from: https://appleid.apple.com/account/manage → App-Specific Passwords
#
# Example format: xxxx-xxxx-xxxx-xxxx
APPLE_APP_PASSWORD=your_apple_password_here

# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# 1. This .env.example file is SAFE to commit (no real secrets)
# 2. Your actual .env file should NEVER be committed (it's in .gitignore)
# 3. Rotate secrets immediately if exposed
# 4. Use different secrets for dev/staging/production
#
# Questions? See: security_audit/SECRET_PROTECTION_GUIDE.md
